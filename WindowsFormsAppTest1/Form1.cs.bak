        private class ReportProccessBarInfo
        {
            public int index;
            public TEST_PHASE phase;
            public bool result;
            public String message;

            public ReportProccessBarInfo(int i, TEST_PHASE p, bool r, String m)
            {
                index = i;
                phase = p;
                result = r;
                message = m;
            }
        };

