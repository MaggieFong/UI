                gridViewTest.Rows[i].Cells[COL_NUM_MEASURED].Value = "";
                gridViewTest.Rows[i].Cells[COL_NUM_STATUS].Value = "";

                testItems.getTestItem(i).sMeasured = null;
                testItems.getTestItem(i).bResult = false;
            }
        }

