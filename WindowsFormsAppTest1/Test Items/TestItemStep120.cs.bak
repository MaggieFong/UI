    }

    class TestItemStep120_P2 : TestItemForm
    {
        public string step = "120 P2";
        private DAQadc taskADC;
        private double r1 = 133;
        private double r2 = 133;
        public TestItemStep120_P2()
        {
            sStep = step;
            LoadSpec();
        }

        public override WORK_STATUS Init()
        {
            //DAQ setting
            try
            {

                taskADC = new DAQadc(
                    10000, 300, DAQadc.VOLTAGE_RANGE.RANGE_0_10);  //sample rate: 10000hz, sample time: 300ms, voltage range: 0~10v
                taskADC.addChannel(DAQ_USB6218.deviceName, DAQ_USB6218.TP501_AI4);
                taskADC.addChannel(DAQ_USB6218.deviceName, DAQ_USB6218.TP504_AI12);

                if (taskADC.start())
                    return WORK_STATUS.PASS;
                else
                {
                    sMeasured = taskADC.getErrorMsg();
                    return WORK_STATUS.FAIL;
                }
            }
            catch (Exception e)
            {
                sMeasured = e.Message;
                return WORK_STATUS.FAIL;
            }
        }
        public override WORK_STATUS Proccess()
        {
            WORK_STATUS re = WORK_STATUS.WORKING;

            if (taskADC.isEnable() == false)
            {
                if (taskADC.getErrorMsg() == null)      //must check if there were any error when DAQadc.callbackADC()
                {
                    double average0 = taskADC.getAverage(0);
                    double measured_v0 = average0 * (r1 + r2) / r2;
                    Console.WriteLine("ai TP501_AI4 average:{0}, measured: {1}", average0, measured_v0);

                    double average1 = taskADC.getAverage(1);
                    double measured_v1 = average1 * (r1 + r2) / r2;
                    Console.WriteLine("ai TP504_AI12 average:{0}, measured: {1}", average1, measured_v1);

                    double result = measured_v0 - measured_v1;
                    sMeasured = Convert.ToString(result);
 
                    //check limitation
                    if (PassFailJudge())
                    {
                        re = WORK_STATUS.PASS;
                    }
                    else
                    {
                        re = WORK_STATUS.FAIL;
                    }
                }
                else
                {
                    sMeasured = taskADC.getErrorMsg();
                    re = WORK_STATUS.FAIL;
                }
            }

            return re;
        }

        public override void release()
        {
            taskADC = null;        //free memory
        }
    }


